//@version=6
indicator("Lele ICT Pro v0.1.0", overlay=true, max_labels_count=500, max_lines_count=500)

//====================================================
// LELE ICT PRO
// Professional ICT / SMC Indicator
// Version: 0.1.0
// Status: Sprint 1 - Market Structure
//====================================================

//=========================
// INPUTS
//=========================
groupStructure = "Market Structure"

swingLength = input.int(5, "Swing Length", minval=2, group=groupStructure)
showSwings = input.bool(true, "Show Swing Points", group=groupStructure)
showBOS = input.bool(true, "Show BOS", group=groupStructure)

//=========================
// COLORS
//=========================
bullColor = color.lime
bearColor = color.red

//=========================
// SWING DETECTION
//=========================
pivotHigh = ta.pivothigh(high, swingLength, swingLength)
pivotLow  = ta.pivotlow(low, swingLength, swingLength)

if showSwings
    if not na(pivotHigh)
        label.new(bar_index - swingLength, pivotHigh, "SH", style=label.style_label_down, color=bearColor, textcolor=color.white)

    if not na(pivotLow)
        label.new(bar_index - swingLength, pivotLow, "SL", style=label.style_label_up, color=bullColor, textcolor=color.white)

//============================
// BREAK OF STRUCTURE (BOS)
//============================

var float lastHigh = na
var float lastLow = na

if not na(pivotHigh)
    lastHigh := pivotHigh

if not na(pivotLow)
    lastLow := pivotLow

bullBOS = ta.crossover(close, lastHigh)
bearBOS = ta.crossunder(close, lastLow)

if showBOS
    if bullBOS
        label.new(bar_index, high,
            "BOS",
            style=label.style_label_up,
            color=color.blue,
            textcolor=color.white)

    if bearBOS
        label.new(bar_index, low,
            "BOS",
            style=label.style_label_down,
            color=color.orange,
            textcolor=color.white)

//============================
// CHANGE OF CHARACTER (CHoCH)
//============================

bullCHoCH = bearBOS[1] and bullBOS
bearCHoCH = bullBOS[1] and bearBOS

if bullCHoCH
    label.new(bar_index, high,
        "CHoCH",
        style=label.style_label_up,
        color=color.green,
        textcolor=color.white)

if bearCHoCH
    label.new(bar_index, low,
        "CHoCH",
        style=label.style_label_down,
        color=color.maroon,
        textcolor=color.white)
